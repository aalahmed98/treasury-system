{
  "name": "nbb-treasury-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "test": "vitest run",
    "e2e": "playwright test --grep-invert @shots",
    "shots": "playwright test --grep @shots"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/react-virtual": "^3.14.26",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
