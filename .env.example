# Copy to .env. These are development values for a local Docker database only.

# --- Postgres container (read by docker compose and db/init/01-roles.sh) ---
POSTGRES_SUPERUSER_PASSWORD=postgres_dev
TREASURY_OWNER_PASSWORD=owner_dev
TREASURY_APP_PASSWORD=app_dev

# --- Server ---
# Owner role: migrate, seed (users and entitlements), and the test suite (sqlx::test reads DATABASE_URL).
DATABASE_URL=postgres://treasury_owner:owner_dev@localhost:5434/treasury
# App role: serve, and seed (deals, booked under each trader's identity). Cannot bypass row-level security.
APP_DATABASE_URL=postgres://treasury_app:app_dev@localhost:5434/treasury

# Plaintext HTTP is only permitted on a loopback address. To listen anywhere else, provide TLS
# (`treasury-server gen-dev-cert` writes a self-signed pair into certs/ for development).
BIND_ADDR=127.0.0.1:8787
#TLS_CERT=certs/dev-server.pem
#TLS_KEY=certs/dev-server-key.pem

SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

RUST_LOG=info,server=debug,sqlx=warn
