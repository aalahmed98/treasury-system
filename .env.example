# Owner role: runs migrations and the test suite (sqlx::test reads DATABASE_URL).
DATABASE_URL=postgres://treasury_owner:owner_dev@localhost:5433/treasury
# App role: what the running server connects as. Cannot bypass row-level security.
APP_DATABASE_URL=postgres://treasury_app:app_dev@localhost:5433/treasury
BIND_ADDR=0.0.0.0:8787
SESSION_TTL_HOURS=12
RUST_LOG=info,server=debug,sqlx=warn
